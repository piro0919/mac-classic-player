{
  "identifier": "default",
  "description": "Mac Classic Player default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-stat",
    "core:window:allow-set-fullscreen",
    "shell:allow-open",
    "updater:default",
    "process:default",
    "window-state:default"
  ]
}
